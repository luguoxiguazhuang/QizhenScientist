# Copy this file to `.env` and fill in the credentials below.
#
#   cp .env.example .env
#
# `.env` is gitignored; never commit it. Only three fields must be filled in
# for a normal run: SCIATLAS_API_KEY, LLM_API_KEY and LLM_BASE_URL. Everything
# else already carries a working default.

# --------------------------------------------------------------------------- #
# SciAtlas knowledge-graph API  (required)
# --------------------------------------------------------------------------- #
SCIATLAS_API_BASE_URL=http://sciatlas.openkg.cn
# REQUIRED. Personal SciAtlas token; run_idea.sh aborts when this is empty.
SCIATLAS_API_KEY=
# KG requests can take several minutes on broad graph queries.
SCIATLAS_TIMEOUT=900
SCIATLAS_RUNS_DIR=./runs

# Downstream workflow wiring. The defaults below select hosted mode, which uses
# SciAtlas/run_sciatlas.py as the retrieval adapter. Leave them as-is unless you
# are running literature_review_pipeline / review_pipeline separately.
SCIATLAS_WORKFLOW_ENV=.env
SCIATLAS_OFFICIAL_CLI_ROOT=.
SCIATLAS_CACHE_DIR=./runs/cache

# Set to 1 only when you have a local Neo4j + embedding KG configured for
# SciAtlas/references/search/run_search.py. Hosted mode leaves this at 0.
SCIATLAS_USE_LOCAL_KG=0
SCIATLAS_LOCAL_SEARCH_ROOT=./references/search
SCIATLAS_MAX_RETRIES=4
SCIATLAS_RETRY_BACKOFF=5.0

# --------------------------------------------------------------------------- #
# LLM provider  (required)
# --------------------------------------------------------------------------- #
# Works with any provider or gateway exposing an OpenAI-compatible Chat
# Completions API. Preferred names are LLM_*; SCIATLAS_LLM_*, SEARCH_LLM_*,
# OPENAI_* and the legacy DMX aliases are also accepted.
LLM_PROVIDER=chat_completions
# REQUIRED. run_idea.sh aborts when this is empty.
LLM_API_KEY=
# REQUIRED in practice. Base URL of the OpenAI-compatible endpoint, including
# the version suffix, e.g. https://dashscope.aliyuncs.com/compatible-mode/v1
# Falls back to https://www.dmxapi.cn/v1 when left empty.
LLM_BASE_URL=
LLM_API_URL=
LLM_CHAT_COMPLETIONS_URL=
# Must be a model name your endpoint actually serves.
LLM_MODEL=qwen3.8-max
LLM_AUTH_HEADER=
LLM_HTTP_HEADERS=
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=4
LLM_MAX_TOKENS=512
# Optional aliases for older setups; leave commented unless you need them.
# SCIATLAS_LLM_API_KEY=
# SCIATLAS_LLM_BASE_URL=
# SCIATLAS_LLM_MODEL=
# SCIATLAS_LLM_TIMEOUT=
# SCIATLAS_LLM_TEMPERATURE=
# SCIATLAS_LLM_MAX_RETRIES=
# SCIATLAS_LLM_MAX_TOKENS=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# SEARCH_LLM_API_KEY=
# SEARCH_LLM_API_URL=
# SEARCH_LLM_MODEL=
# DMX_API_KEY=

# --------------------------------------------------------------------------- #
# Optional enrichment services
# --------------------------------------------------------------------------- #
# Semantic Scholar enrichment for the workflow search stages.
S2_API_KEY=

# GROBID server, used only by PDF-input workflows (`--pdf`).
GROBID_BASE_URL=http://127.0.0.1:8070

# OpenAlex fallback/enrichment.
OA_API_KEY=
OPENALEX_MAILTO=

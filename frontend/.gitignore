# Repository root. site/ has its own .gitignore for the web app; this one
# covers anything created at the top level, where previously nothing was
# ignored at all — an npm install or a stray log here showed up as untracked.

node_modules/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Python tooling for scripts/ (build_database_data.py, gen-skill-data.py)
__pycache__/
*.py[cod]
.venv/
venv/
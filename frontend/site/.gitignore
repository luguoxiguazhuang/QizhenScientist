node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- Build output ---
dist/
dist-ssr/
build/

# --- Vite cache ---
.vite/
.cache/
*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/

*.sw?

# --- Env / secrets ---
.env
.env.local
.env.*.local

# --- Coverage / test artifacts ---
coverage/
*.lcov

# Crop-discovery overlays from `npm run figures -- --grid <file>`. Regenerable
# from paper/, and only useful while picking crop fractions by eye.
public/figures/_grid/

# --- Misc ---
*.tsbuildinfo
.eslintcache
data/import_debug/

# Runtime state written by server/index.js. It changes on every request, so
# tracking it means every deploy host has a dirty tree and a pull conflict.
data/visits.json
data/visits.json.tmp

# Screenshots from scripts/shot.mjs — local review only.
.shots/

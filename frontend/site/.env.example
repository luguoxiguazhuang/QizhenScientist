# Mechanist frontend environment variables.
# Copy to .env.local and adjust. Everything here is optional.
#
# There is no longer a Node backend to configure: the site is a static build.
# In production nginx serves dist/ and proxies the API paths to the Mechanic-DB
# service — see deploy/nginx.mechanist.openkg.cn.conf in the
# scientist_database_deploy repository.

# --- Build ---------------------------------------------------------------

# Where the Mechanic-DB registration form posts.
#
# Leave unset for the self-hosted deployment: the default is the same-origin
# path /register, which is the only setting under which the inline form can
# work (the API has no CORS middleware and answers on port 80 only).
#
# Set it to the absolute http:// URL for a build served from a different
# origin, such as GitHub Pages. The app detects the mixed-content case and
# shows the equivalent curl command instead of an unusable form.
# VITE_REGISTER_API=http://mechanist.openkg.cn/register

# --- Vite dev server (npm run dev) ---------------------------------------

# Port. Default 5173. strictPort is on, so if that port is already taken the
# run aborts rather than sliding to another one — set this instead of letting
# it fail. On a shared machine 5173 is often already in use.
# VITE_PORT=5273

# Bind address. Default 127.0.0.1 (loopback only). Set to 0.0.0.0 to open the
# dev server to the rest of the network.
# VITE_HOST=0.0.0.0

# Where the API paths (/register, /search, /api/*, …) are proxied in
# development. Default is the Mechanic-DB FastAPI service on its usual port.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:9001
